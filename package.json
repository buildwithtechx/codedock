{
  "name": "codedock",
  "private": true,
  "version": "0.1.0",
  "description": "Codedock self-hosted PaaS control plane & dashboard",
  "license": "Codedock Source-Available License",
  "type": "module",
  "imports": {
    "#/*": "./dashboard/src/*"
  },
  "scripts": {
    "dev": "concurrently -k -n \"daemon,dashboard\" -c \"blue,magenta\" \"npm run dev:daemon\" \"npm run dev:dashboard\"",
    "dev:dryrun": "DEPLOY_DRY_RUN=true npm run dev",
    "dev:daemon": "go run github.com/air-verse/air@latest -c .air.toml",
    "dev:dashboard": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "npm run build:dashboard && npm run build:daemon",
    "build:daemon": "go build -ldflags \"-s -w\" -o bin/codedockd ./cmd/codedockd",
    "build:dashboard": "vite build",
    "preview": "vite preview",
    "check": "go fmt ./... && go vet ./... && npm run format",
    "fmt": "go fmt ./... && npm run format:fix",
    "format": "biome check dashboard/src",
    "format:fix": "biome check --write dashboard/src",
    "typecheck": "tsc --noEmit",
    "test": "go test ./... -v && vitest run",
    "docker:build": "docker build -t ghcr.io/buildwithtechx/codedock:dev .",
    "docker:up": "docker network create codedock-network 2>/dev/null || true && docker run -d --name codedock-control-plane --restart unless-stopped -p 8080:8080 -p 80:80 -p 443:443 -v codedock_data:/codedock/data -e CODEDOCK_DATA_DIR=/codedock/data -v /var/run/docker.sock:/var/run/docker.sock:ro --network codedock-network ghcr.io/buildwithtechx/codedock:dev",
    "docker:down": "docker stop codedock-control-plane && docker rm codedock-control-plane",
    "clean": "rm -rf bin codedockd dashboard/dist"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@hookform/resolvers": "^5.5.7",
    "@monaco-editor/react": "^4.7.0",
    "@posthog/react": "^1.10.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.168.23",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.407.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
