#!/usr/bin/env bash
set -eo pipefail

CODEDOCK_DIR=${CODEDOCK_DIR:-/codedock}
CONTAINER_NAME="codedock-control-plane"
BOLD="\033[1m"
DIM="\033[2m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
NC="\033[0m"

show_help() {
  echo -e "${BOLD}Codedock Control (codedockd / codedockctl)${NC} — CLI admin tools for Codedock"
  echo ""
  echo -e "${BOLD}Usage:${NC} codedockd <command> [args]"
  echo ""
  echo -e "${BOLD}Commands:${NC}"
  echo "  setup                    Run interactive setup wizard"
  echo "  reset-password           Reset admin password"
  echo "  config                   View/update configuration"
  echo "  status                   Show daemon health & containers"
  echo "  restart                  Restart Codedock daemon"
  echo "  logs                    Tail daemon logs"
  echo "  update [version]         Upgrade to a specific version"
  echo "  downgrade <version>      Downgrade to a specific version"
  echo "  backup                   Create manual database backup"
  echo "  uninstall                Remove Codedock daemon"
  echo "  version                  Show Codedock version"
  echo "  help                     Show help message"
}

case "${1:-help}" in
  setup|reset-password|config|deploy|apps:*|db:*)
    docker exec -i "$CONTAINER_NAME" codedockd "$@"
    ;;
  version)
    docker exec -i "$CONTAINER_NAME" codedockd version
    ;;
  restart)
    echo -e "${BOLD}🔄 Restarting Codedock...${NC}"
    docker restart "$CONTAINER_NAME"
    echo -e "${GREEN}✅ Codedock restarted.${NC}"
    ;;
  logs)
    shift
    docker logs "$@" "$CONTAINER_NAME"
    ;;
  status)
    echo -e "${BOLD}📊 Codedock Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━"
    STATUS=$(docker ps --filter name="$CONTAINER_NAME" --format '{{.Status}}' 2>/dev/null)
    if [ -n "$STATUS" ]; then
      echo -e "  ${BOLD}Daemon:${NC}     ${GREEN}running${NC} ($STATUS)"
    else
      echo -e "  ${BOLD}Daemon:${NC}     ${RED}not running${NC}"
    fi
    VERSION=$(docker exec -i "$CONTAINER_NAME" codedockd version 2>/dev/null || echo "unavailable")
    echo -e "  ${BOLD}Version:${NC}    $VERSION"
    echo -e "  ${BOLD}Data dir:${NC}   $CODEDOCK_DIR/data"
    echo ""
    echo -e "${BOLD}  Active Containers:${NC}"
    docker ps --filter network=codedock-network --format '  {{.Names}} ({{.Image}}, {{.Status}})' 2>/dev/null || echo "    None"
    ;;
  update)
    TARGET_VERSION="${2:-latest}"
    if [ "$TARGET_VERSION" = "latest" ]; then
      TARGET_VERSION=$(curl -fsS "https://api.github.com/repos/buildwithtechx/codedock/releases/latest" 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4 || echo "latest")
    fi
    echo -e "${BOLD}💾 Creating pre-update backup...${NC}"
    mkdir -p "$CODEDOCK_DIR/data/backups"
    docker exec -i "$CONTAINER_NAME" sh -c "cp /codedock/data/codedock.db /codedock/data/backups/codedock-pre-upgrade-$(date +%Y%m%d%H%M%S).db" 2>/dev/null || true
    
    echo -e "${BOLD}🐳 Pulling codedock:${TARGET_VERSION}...${NC}"
    docker pull "ghcr.io/buildwithtechx/codedock:${TARGET_VERSION}"
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    docker rm "$CONTAINER_NAME" 2>/dev/null || true
    docker run -d \
      --name "$CONTAINER_NAME" \
      --restart unless-stopped \
      -p 8080:8080 -p 80:80 -p 443:443 \
      --env-file "$CODEDOCK_DIR/.env" \
      -e CODEDOCK_DATA_DIR=/codedock/data \
      -v codedock_data:/codedock/data \
      -v "${DOCKER_SOCKET_PATH:-/var/run/docker.sock}":/var/run/docker.sock:ro \
      --network codedock-network \
      ghcr.io/buildwithtechx/codedock:"${TARGET_VERSION}"
    echo -e "${GREEN}✅ Codedock updated to ${TARGET_VERSION}.${NC}"
    ;;
  downgrade)
    if [ -z "$2" ]; then
      echo -e "${RED}❌ Usage: codedockctl downgrade <version>${NC}"
      exit 1
    fi
    TARGET_VERSION="$2"
    echo -e "${BOLD}💾 Creating pre-downgrade backup...${NC}"
    mkdir -p "$CODEDOCK_DIR/data/backups"
    docker exec -i "$CONTAINER_NAME" sh -c "cp /codedock/data/codedock.db /codedock/data/backups/codedock-pre-downgrade-$(date +%Y%m%d%H%M%S).db" 2>/dev/null || true
    docker pull "ghcr.io/buildwithtechx/codedock:${TARGET_VERSION}"
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    docker rm "$CONTAINER_NAME" 2>/dev/null || true
    docker run -d \
      --name "$CONTAINER_NAME" \
      --restart unless-stopped \
      -p 8080:8080 -p 80:80 -p 443:443 \
      --env-file "$CODEDOCK_DIR/.env" \
      -e CODEDOCK_DATA_DIR=/codedock/data \
      -v codedock_data:/codedock/data \
      -v "${DOCKER_SOCKET_PATH:-/var/run/docker.sock}":/var/run/docker.sock:ro \
      --network codedock-network \
      ghcr.io/buildwithtechx/codedock:"${TARGET_VERSION}"
    echo -e "${GREEN}✅ Downgraded to ${TARGET_VERSION}.${NC}"
    ;;
  uninstall)
    echo -e "${BOLD}🛑 Stopping Codedock daemon...${NC}"
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    docker rm "$CONTAINER_NAME" 2>/dev/null || true
    if command -v systemctl &>/dev/null; then
      systemctl stop codedock.service 2>/dev/null || true
      systemctl disable codedock.service 2>/dev/null || true
      rm -f /etc/systemd/system/codedock.service
      systemctl daemon-reload
    fi
    rm -f /usr/local/bin/codedockd /usr/local/bin/codedockctl
    echo -e "${GREEN}✅ Codedock daemon removed.${NC}"
    ;;
  backup)
    BACKUP_FILE="$CODEDOCK_DIR/data/backups/codedock-manual-$(date +%Y%m%d%H%M%S).db"
    mkdir -p "$CODEDOCK_DIR/data/backups"
    docker exec -i "$CONTAINER_NAME" sh -c "cp /codedock/data/codedock.db /codedock/data/backups/tmp.db"
    docker cp "$CONTAINER_NAME":/codedock/data/backups/tmp.db "$BACKUP_FILE"
    docker exec -i "$CONTAINER_NAME" sh -c "rm /codedock/data/backups/tmp.db"
    echo -e "${GREEN}✅ Database backed up to $BACKUP_FILE${NC}"
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo -e "${RED}❌ Unknown command: ${1}${NC}"
    show_help
    exit 1
    ;;
esac
