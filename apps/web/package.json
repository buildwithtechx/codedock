{
  "name": "@codedock/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:apps": "node scripts/generate-app-catalog.mjs && biome check --write src/features/templates/app-catalog.generated.ts",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run generate:apps && npm run generate:sitemap && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist/ --project-name codedock-web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codedock/ui": "*",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
