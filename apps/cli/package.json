{
  "name": "codedock",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buildwithtechx/codedock",
    "directory": "apps/cli"
  },
  "type": "module",
  "description": "Codedock CLI installer — downloads the prebuilt Go binary for your platform",
  "license": "Apache-2.0",
  "main": "./lib.js",
  "exports": {
    ".": "./lib.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/codedock.js",
    "install.js",
    "lib.js",
    "client.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codedock": "./bin/codedock.js"
  },
  "scripts": {
    "postinstall": "node ./install.js",
    "test": "node --test lib.test.js"
  },
  "keywords": [
    "codedock",
    "paas",
    "docker",
    "self-hosted",
    "deploy",
    "cli"
  ],
  "author": "TechX"
}
