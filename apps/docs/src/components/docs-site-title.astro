---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="docs-site-title">
  <span class="docs-site-title__mark">
    <img src="/favicon.svg" alt="Codedock Logo" width="32" height="32" />
  </span>
  <span class="docs-site-title__text" translate="no">Codedock</span>
</a>

<style>
  @layer starlight.components {
    .docs-site-title {
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 0.75rem;
      color: var(--sl-color-white);
      font-family: var(--sl-font-heading);
      font-size: var(--sl-text-lg);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      letter-spacing: -0.02em;
    }

    .docs-site-title:hover .docs-site-title__text {
      color: var(--sl-color-accent);
    }

    .docs-site-title__mark {
      display: flex;
      width: 2rem;
      height: 2rem;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      border-radius: 0.5rem;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    .docs-site-title__mark img {
      width: 2rem;
      height: 2rem;
      display: block;
      object-fit: contain;
    }
  }
</style>
