---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="docs-site-title">
  <span class="docs-site-title__mark">
    <img src="/favicon.svg" alt="" />
  </span>
  <span translate="no">Codedock</span>
</a>

<style>
  @layer starlight.components {
    .docs-site-title {
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 0.65rem;
      color: var(--sl-color-white);
      font-family: var(--sl-font-heading);
      font-size: var(--sl-text-lg);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      letter-spacing: -0.015em;
    }

    .docs-site-title__mark {
      display: grid;
      width: 1.85rem;
      height: 1.85rem;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 0.45rem;
      border: 1px solid rgba(139, 92, 246, 0.35);
      background: var(--codedock-accent-light);
    }

    .docs-site-title__mark img {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>
