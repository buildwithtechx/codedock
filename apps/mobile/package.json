{
  "name": "@codedock/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:dev": "eas build --platform all --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "submit": "eas submit --platform all --profile production",
    "update:dev": "eas update --channel development --auto",
    "update:preview": "eas update --channel preview --auto",
    "update:prod": "eas update --channel production --auto",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch --coverage=false",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@react-native-vector-icons/material-design-icons": "^13.1.5",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "expo": "~57.0.30",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.11",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
