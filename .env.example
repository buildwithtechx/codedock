# Server & Host Configuration
PORT=8080
HOST=0.0.0.0
CODEDOCK_DATA_DIR=./data
CODEDOCK_HOST_IP=
CODEDOCK_DOMAIN=
CODEDOCK_DASHBOARD_URL=http://localhost:3000
CODEDOCK_SERVER_URL=http://localhost:8080
CODEDOCK_API_HOST=http://localhost:8080
CODEDOCK_STATIC_DIR=

# Security & Authentication Secrets (Generate with: openssl rand -hex 32)
CODEDOCK_JWT_SECRET=
CODEDOCK_REFRESH_SECRET=
CODEDOCK_TLS_EMAIL=

# Docker Engine & Deployment Network Settings
DOCKER_SOCKET_PATH=/var/run/docker.sock
CODEDOCK_RUNTIME_NETWORK=codedock-network
DEPLOY_HOST_PORT_START=4100
DEPLOY_HOST_PORT_END=4999
DEPLOY_DRY_RUN=false

# Traefik Reverse Proxy Configuration
CODEDOCK_TRAEFIK_HTTP_PORT=80
CODEDOCK_TRAEFIK_HTTPS_PORT=443
CODEDOCK_TRAEFIK_API_PORT=8082
CODEDOCK_TRAEFIK_IMAGE=traefik:v3.3

# Builder & Nixpacks Container Images
CODEDOCK_NIXPACKS_IMAGE=ghcr.io/railwayapp/nixpacks:latest
CODEDOCK_PACK_IMAGE=buildpacksio/pack:latest
CODEDOCK_BUILDER_IMAGE=

# Default Container Resource Allocation Limits
CODEDOCK_DEFAULT_APP_PORT=3000
CODEDOCK_DEFAULT_MEMORY_MB=512
CODEDOCK_DEFAULT_CPU=0.5
CODEDOCK_DEFAULT_DB_MEMORY_MB=1024
CODEDOCK_DEFAULT_DB_CPU=1.0

# Build Queue & Execution Constraints
CODEDOCK_MAX_CONCURRENT_BUILDS=2
CODEDOCK_DEPLOYMENT_TIMEOUT=1800

# Routing & Wildcard Domain Config
CODEDOCK_WILDCARD_DOMAIN=
CODEDOCK_MAGIC_DOMAIN=

# Remote Worker Nodes & Real-time WebSockets
CODEDOCK_USE_WSS=false
CODEDOCK_WORKER_TOKEN=

# Automatic System Updates & Release Endpoints
CODEDOCK_UPDATE_URL=https://api.github.com/repos/buildwithtechx/codedock/releases/latest
CODEDOCK_DOWNLOAD_URL=https://github.com/buildwithtechx/codedock/releases

# Telemetry & Anonymous Analytics Settings
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISTINCT_ID_SALT=

VITE_APP_TITLE=CodeDock
VITE_API_URL=/api
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ==============================================================================
# Codedock Managed Cloud Specific Variables
# ==============================================================================
CODEDOCK_CLOUD_MODE=false

# Global Email Notification & System SMTP Fallbacks
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=

# Global OAuth Single Sign-On Fallbacks (GitHub & Google)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
