PORT=8080
HOST=0.0.0.0
CODEDOCK_DATA_DIR=./data
CODEDOCK_HOST_IP=
CODEDOCK_DOMAIN=
CODEDOCK_DASHBOARD_URL=http://localhost:3000
CODEDOCK_SERVER_URL=http://localhost:8080
CODEDOCK_API_HOST=http://localhost:8080
CODEDOCK_STATIC_DIR=

# generate with: openssl rand -hex 32
CODEDOCK_JWT_SECRET=
CODEDOCK_REFRESH_SECRET=
CODEDOCK_TLS_EMAIL=

DOCKER_SOCKET_PATH=/var/run/docker.sock
CODEDOCK_RUNTIME_NETWORK=codedock-network
DEPLOY_HOST_PORT_START=4100
DEPLOY_HOST_PORT_END=4999
DEPLOY_DRY_RUN=false

CODEDOCK_TRAEFIK_HTTP_PORT=80
CODEDOCK_TRAEFIK_HTTPS_PORT=443
CODEDOCK_TRAEFIK_API_PORT=8082
CODEDOCK_TRAEFIK_IMAGE=traefik:v3.3

CODEDOCK_NIXPACKS_IMAGE=ghcr.io/railwayapp/nixpacks:latest
CODEDOCK_PACK_IMAGE=buildpacksio/pack:latest
CODEDOCK_BUILDER_IMAGE=

CODEDOCK_DEFAULT_APP_PORT=3000
CODEDOCK_DEFAULT_MEMORY_MB=512
CODEDOCK_DEFAULT_CPU=0.5
CODEDOCK_DEFAULT_DB_MEMORY_MB=1024
CODEDOCK_DEFAULT_DB_CPU=1.0

CODEDOCK_MAX_CONCURRENT_BUILDS=2
CODEDOCK_DEPLOYMENT_TIMEOUT=1800

CODEDOCK_WILDCARD_DOMAIN=
CODEDOCK_MAGIC_DOMAIN=

CODEDOCK_USE_WSS=false
CODEDOCK_WORKER_TOKEN=

CODEDOCK_UPDATE_URL=https://api.github.com/repos/buildwithtechx/codedock/releases/latest
CODEDOCK_DOWNLOAD_URL=https://github.com/buildwithtechx/codedock/releases

# Stripe — required for Codedock Cloud billing (leave empty for self-hosted)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
